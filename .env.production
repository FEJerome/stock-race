# Stock Race 生产环境配置
# 请根据实际部署环境修改以下值

# ============ 数据库配置 ============
# PostgreSQL (元数据数据库)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_race
DB_USER=postgres
DB_PASSWORD=postgres_change_me_in_production

# TimescaleDB (时序数据库)
TSDB_HOST=timescaledb
TSDB_PORT=5432
TSDB_NAME=stock_race_tsdb
TSDB_USER=timescale
TSDB_PASSWORD=password_change_me_in_production

# Redis (缓存和队列)
REDIS_URL=redis://redis:6379

# ============ 服务配置 ============
# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# AI服务
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_DEBUG=false
AI_SERVICE_API_KEY=stock-race-ai-key-production

# 数据服务
DATA_SERVICE_HOST=0.0.0.0
DATA_SERVICE_PORT=8001
DATA_SERVICE_DEBUG=false

# 前端服务
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# ============ AI提供商API密钥 ============
# 至少配置一个AI提供商才能使用真实AI决策
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# ============ 服务间通信 ============
BACKEND_URL=http://backend:3001
AI_SERVICE_URL=http://ai-service:8000
DATA_SERVICE_URL=http://data-service:8001
FRONTEND_URL=http://frontend:3000

# ============ CORS配置 ============
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ============ 安全配置 ============
# 速率限制
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# API密钥 (用于服务间认证)
API_KEY=stock-race-api-key-production
AI_SERVICE_API_KEY=stock-race-ai-key-production
DATA_SERVICE_API_KEY=stock-race-data-key-production

# ============ 交易参数 ============
MAX_POSITION_SIZE=100000
MIN_TRADE_AMOUNT=1000
DEFAULT_TRADING_FEE=0.001

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE=/var/log/stock-race

# ============ 监控配置 ============
# Prometheus指标端点
METRICS_ENABLED=true
METRICS_PORT=9090

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30
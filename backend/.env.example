# 旧 backend 本地配置模板；不是 V3 配置。
# 在本机 .env 中填写私有值，不得提交真实密码或密钥。

# 应用配置
NODE_ENV=development
PORT=3001
API_PREFIX=/api
CORS_ORIGIN=http://127.0.0.1:3000

# 数据库配置（Prisma 使用 DATABASE_URL，旧服务配置使用 DB_*）
DATABASE_URL=postgresql://stock_race_local:__SET_LOCAL_ONLY__@127.0.0.1:5432/stock_race
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stock_race
DB_USER=stock_race_local
DB_PASSWORD=__SET_LOCAL_ONLY__
DB_SSL=false

# Redis 配置
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 会话与认证配置
SESSION_TTL=86400
MAX_SESSIONS_PER_USER=5
JWT_SECRET=__SET_LOCAL_ONLY__
JWT_EXPIRES_IN=24h
ADMIN_PASSWORD=__SET_LOCAL_ONLY__

# 外部服务默认不配置；调用前需要单独授权
ALPHA_VANTAGE_API_KEY=
TIINGO_API_KEY=

# 旧服务间配置
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=
DATA_SERVICE_URL=http://127.0.0.1:8001
DATA_SERVICE_API_KEY=
DATA_SERVICE_API_PREFIX=/api/v1
DATA_SERVICE_HEALTH_CHECK_INTERVAL=30000
DATA_SERVICE_MAX_FALLBACK_DURATION=300000
DATA_SERVICE_QUALITY_THRESHOLD=0.8

FRONTEND_URL=http://127.0.0.1:3000

# 限流与日志
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# 邮件通知默认不配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

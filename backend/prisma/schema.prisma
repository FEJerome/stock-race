generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int           @id @default(autoincrement())
  username            String        @unique @db.VarChar(50)
  email               String        @unique @db.VarChar(100)
  passwordHash        String        @db.VarChar(255)
  salt                String        @db.VarChar(50)
  status              UserStatus    @default(active)
  lastLoginAt         DateTime?     @db.Timestamptz(6)
  failedLoginAttempts Int           @default(0)
  lockUntil           DateTime?     @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @db.Timestamptz(6)
  watchlist           Watchlist[]
  aiAccounts          AIAccount[]
  systemLogs          SystemLog[]
  userSettings        UserSettings?

  @@index([username])
  @@index([email])
  @@index([status])
}

model AIAccount {
  id               Int              @id @default(autoincrement())
  userId           Int
  name             String           @db.VarChar(100)
  description      String?
  modelType        ModelType        @default(deepseek)
  initialBalance   Decimal          @default(100000.00) @db.Decimal(15, 2)
  currentBalance   Decimal          @default(100000.00) @db.Decimal(15, 2)
  totalValue       Decimal          @default(100000.00) @db.Decimal(15, 2)
  status           AccountStatus    @default(active)
  tradingFrequency TradingFrequency @default(daily)
  riskLevel        RiskLevel        @default(medium)
  promptTemplate   String?
  config           Json             @default("{}")
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @db.Timestamptz(6)
  portfolios       Portfolio[]
  rankings         Ranking[]
  trades           Trade[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionLogs     DecisionLog[]
  systemLogs       SystemLog[]

  @@index([userId])
  @@index([status])
  @@index([modelType])
  @@map("ai_accounts")
}

model Stock {
  id                Int           @id @default(autoincrement())
  code              String        @unique @db.VarChar(10)
  name              String        @db.VarChar(100)
  fullName          String?       @db.VarChar(200)
  market            Market
  industry          String?       @db.VarChar(100)
  subIndustry       String?       @db.VarChar(100)
  listingDate       DateTime?     @db.Date
  totalShares       BigInt?
  circulatingShares BigInt?
  status            StockStatus   @default(normal)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @db.Timestamptz(6)
  portfolios        Portfolio[]
  trades            Trade[]
  watchlist         Watchlist[]
  decisionLogs      DecisionLog[]

  @@index([code])
  @@index([market])
  @@index([industry])
  @@index([status])
}

model Portfolio {
  id             Int       @id @default(autoincrement())
  accountId      Int
  stockId        Int
  quantity       Int       @default(0)
  avgCost        Decimal   @db.Decimal(10, 4)
  currentPrice   Decimal?  @db.Decimal(10, 4)
  marketValue    Decimal?  @db.Decimal(15, 2)
  profitLoss     Decimal?  @db.Decimal(15, 2)
  profitLossRate Decimal?  @db.Decimal(8, 4)
  firstBoughtAt  DateTime? @db.Timestamptz(6)
  lastTradedAt   DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @db.Timestamptz(6)
  account        AIAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock          Stock     @relation(fields: [stockId], references: [id])

  @@unique([accountId, stockId])
  @@index([accountId])
  @@index([stockId])
  @@index([updatedAt])
}

model Trade {
  id           Int           @id @default(autoincrement())
  accountId    Int
  stockId      Int
  tradeType    TradeType
  orderType    OrderType     @default(market)
  quantity     Int
  price        Decimal       @db.Decimal(10, 4)
  amount       Decimal       @db.Decimal(15, 2)
  fee          Decimal       @default(0.00) @db.Decimal(10, 2)
  netAmount    Decimal       @db.Decimal(15, 2)
  status       TradeStatus   @default(pending)
  reason       String?       @db.VarChar(100)
  executedAt   DateTime?     @db.Timestamptz(6)
  cancelledAt  DateTime?     @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @db.Timestamptz(6)
  account      AIAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock        Stock         @relation(fields: [stockId], references: [id])
  decisionLogs DecisionLog[]

  @@index([accountId])
  @@index([stockId])
  @@index([tradeType])
  @@index([status])
  @@index([executedAt])
  @@index([createdAt])
}

model DecisionLog {
  id                  Int          @id @default(autoincrement())
  accountId           Int
  tradeId             Int?
  decisionType        DecisionType
  reasoning           String
  confidence          Decimal?     @db.Decimal(5, 4)
  riskLevel           RiskLevel?
  marketAnalysis      Json?
  technicalIndicators Json?
  fundamentalAnalysis Json?
  inputData           Json?
  outputData          Json?
  modelUsed           String?      @db.VarChar(50)
  promptVersion       String?      @db.VarChar(50)
  processingTimeMs    Int?
  apiCost             Decimal?     @db.Decimal(10, 6)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  stockId             Int?
  account             AIAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock               Stock?       @relation(fields: [stockId], references: [id])
  trade               Trade?       @relation(fields: [tradeId], references: [id])

  @@index([accountId])
  @@index([tradeId])
  @@index([decisionType])
  @@index([createdAt])
  @@index([riskLevel])
  @@map("decision_logs")
}

model Ranking {
  id               Int        @id @default(autoincrement())
  accountId        Int
  periodType       PeriodType
  periodDate       DateTime   @db.Date
  rank             Int
  totalReturn      Decimal    @db.Decimal(8, 4)
  annualizedReturn Decimal?   @db.Decimal(8, 4)
  sharpeRatio      Decimal?   @db.Decimal(8, 4)
  maxDrawdown      Decimal?   @db.Decimal(8, 4)
  winRate          Decimal?   @db.Decimal(8, 4)
  profitFactor     Decimal?   @db.Decimal(8, 4)
  totalTrades      Int?
  totalVolume      Decimal?   @db.Decimal(15, 2)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @default(now()) @db.Timestamptz(6)
  account          AIAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodType, periodDate])
  @@index([periodType])
  @@index([periodDate])
  @@index([rank])
  @@index([totalReturn])
}

model UserSettings {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  theme         Theme    @default(light)
  language      Language @default(zh_CN)
  timezone      String   @default("Asia/Shanghai") @db.VarChar(50)
  currency      String   @default("CNY") @db.VarChar(10)
  numberFormat  String   @default("standard") @db.VarChar(20)
  dateFormat    String   @default("YYYY-MM-DD") @db.VarChar(20)
  notifications Json     @default("{\"marketing\": false, \"aiDecision\": true, \"priceAlert\": false, \"tradeExecuted\": true, \"systemMaintenance\": true}")
  chartSettings Json     @default("{\"theme\": \"light\", \"showMA\": true, \"showVolume\": true, \"defaultPeriod\": \"1d\"}")
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model Watchlist {
  id         Int        @id @default(autoincrement())
  userId     Int
  stockId    Int
  customName String?    @db.VarChar(100)
  notes      String?
  alertPrice Decimal?   @db.Decimal(10, 4)
  alertType  AlertType?
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @db.Timestamptz(6)
  stock      Stock      @relation(fields: [stockId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stockId])
  @@index([userId])
  @@index([stockId])
}

model SystemLog {
  id         Int        @id @default(autoincrement())
  level      LogLevel
  module     String     @db.VarChar(50)
  action     String     @db.VarChar(100)
  userId     Int?
  accountId  Int?
  message    String
  metadata   Json?
  ipAddress  String?    @db.Inet
  userAgent  String?
  durationMs Int?
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  account    AIAccount? @relation(fields: [accountId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  @@index([level])
  @@index([module])
  @@index([userId])
  @@index([createdAt])
  @@index([module, action])
  @@map("system_logs")
}

enum UserStatus {
  active
  inactive
  suspended
}

enum ModelType {
  deepseek
  glm
}

enum AccountStatus {
  active
  paused
  stopped
}

enum TradingFrequency {
  minutely
  hourly
  daily
  weekly
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum Market {
  sh
  sz
  bj
  hk
}

enum StockStatus {
  normal
  suspended
  delisted
}

enum TradeType {
  buy
  sell
}

enum OrderType {
  market
  limit
  stop
}

enum TradeStatus {
  pending
  executed
  cancelled
  rejected
  expired
}

enum DecisionType {
  buy
  sell
  hold
  analyze
}

enum PeriodType {
  daily
  weekly
  monthly
  total
}

enum Theme {
  light
  dark
  auto
}

enum Language {
  zh_CN
  en_US
}

enum AlertType {
  above
  below
  both
}

enum LogLevel {
  debug
  info
  warn
  error
  fatal
}

{
  "name": "stock-race-backend",
  "version": "0.1.0",
  "description": "Stock Race Backend API Server",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build": "echo '后端无需构建'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node src/database/migrations/run-migrations.js up",
    "prisma:migrate:down": "node src/database/migrations/run-migrations.js down",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:seed": "node src/database/seeds/run-seeds.js",
    "prisma:studio": "prisma studio",
    "prisma:db-push": "prisma db push",
    "prisma:db-pull": "prisma db pull",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose down && docker-compose up -d --build",
    "health": "curl http://localhost:3001/api/health",
    "docs": "echo 'API文档: http://localhost:3001/api/docs'"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.11.3",
    "prisma": "^5.9.1",
    "redis": "^4.6.11",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

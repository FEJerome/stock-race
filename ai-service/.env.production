# AI Service Production Environment Configuration
# 请在生产环境中修改所有默认值

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_race_prod
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Redis Configuration
REDIS_URL=redis://:CHANGE_ME_IN_PRODUCTION@redis:6379

# AI Provider API Keys - 请配置真实的API密钥
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
QWEN_API_KEY=sk-your-qwen-api-key

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Trading Parameters
MAX_POSITION_SIZE=100000.0
MIN_TRADE_AMOUNT=1000.0
DEFAULT_TRADING_FEE=0.001

# Service URLs
BACKEND_URL=http://backend:3001
DATA_SERVICE_URL=http://data-service:8001

# Logging
LOG_LEVEL=WARNING
LOG_FILE=logs/ai_service.log

# Model Defaults
DEFAULT_MODEL=gpt-4-turbo-preview
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

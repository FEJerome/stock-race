# 旧 ai-service 本地配置模板；不是 V3 模型适配器配置。
# 外部模型默认不配置，调用前需要单独授权。

HOST=127.0.0.1
PORT=8000
DEBUG=False

CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001

# 旧数据库与缓存配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stock_race
DB_USER=stock_race_local
DB_PASSWORD=__SET_LOCAL_ONLY__
REDIS_URL=redis://127.0.0.1:6379

# 外部模型密钥只填写在本机 .env，不得提交
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# 仅用于历史模拟交易服务
MAX_POSITION_SIZE=100000.0
MIN_TRADE_AMOUNT=1000.0
DEFAULT_TRADING_FEE=0.001

BACKEND_URL=http://127.0.0.1:3001
BACKEND_API_KEY=
DATA_SERVICE_URL=http://127.0.0.1:8001

LOG_LEVEL=INFO
LOG_FILE=logs/ai_service.log

DEFAULT_MODEL=gpt-4-turbo-preview
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# 旧 docker-compose.prod.yml 插值模板，仅供本地研究参考。
# 不是 V3 配置或部署指南；当前项目没有需要维护的生产实例。
# 在本机 .env 中填写私有值，不得提交真实密码。

POSTGRES_DB=stock_race_local
POSTGRES_USER=stock_race_local
POSTGRES_PASSWORD=__SET_LOCAL_ONLY__

TSDB_DB=stock_race_tsdb_local
TSDB_USER=stock_race_tsdb_local
TSDB_PASSWORD=__SET_LOCAL_ONLY__

REDIS_PASSWORD=__SET_LOCAL_ONLY__
REDIS_MAX_MEMORY=256mb

GRAFANA_USER=__SET_LOCAL_ONLY__
GRAFANA_PASSWORD=__SET_LOCAL_ONLY__
GRAFANA_URL=http://127.0.0.1:3002

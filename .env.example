# Interpolation template for the legacy docker-compose.prod.yml, kept for local research reference only.
# Not a V3 configuration or deployment guide; there is no production instance to maintain.
# Fill in private values in your local .env; never commit real passwords.

POSTGRES_DB=stock_race_local
POSTGRES_USER=stock_race_local
POSTGRES_PASSWORD=__SET_LOCAL_ONLY__

TSDB_DB=stock_race_tsdb_local
TSDB_USER=stock_race_tsdb_local
TSDB_PASSWORD=__SET_LOCAL_ONLY__

REDIS_PASSWORD=__SET_LOCAL_ONLY__
REDIS_MAX_MEMORY=256mb

GRAFANA_USER=__SET_LOCAL_ONLY__
GRAFANA_PASSWORD=__SET_LOCAL_ONLY__
GRAFANA_URL=http://127.0.0.1:3002

# Required variables added after the hygiene pass (weak defaults removed from
# source and compose; missing values now fail explicitly). Keep values in your
# local .env only; never commit them.

# backend: JWT signing secret / initial admin password / service-to-service API keys
JWT_SECRET=__SET_LOCAL_ONLY__
ADMIN_PASSWORD=__SET_LOCAL_ONLY__
BACKEND_API_KEY=__SET_LOCAL_ONLY__
AI_SERVICE_API_KEY=__SET_LOCAL_ONLY__
DATA_SERVICE_API_KEY=__SET_LOCAL_ONLY__

# Database password (read via DB_PASSWORD by backend/ai-service/data-service)
DB_PASSWORD=__SET_LOCAL_ONLY__

# Password used when the seed script creates the admin user (backend/prisma/seed.js, run-seeds.js)
SEED_ADMIN_PASSWORD=__SET_LOCAL_ONLY__

# Development compose extras (docker-compose.yml / backend/docker-compose*.yml)
PGADMIN_DEFAULT_PASSWORD=__SET_LOCAL_ONLY__
HTTP_PASSWORD=__SET_LOCAL_ONLY__
GF_SECURITY_ADMIN_PASSWORD=__SET_LOCAL_ONLY__

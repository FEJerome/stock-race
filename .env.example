# 旧 docker-compose.prod.yml 插值模板，仅供本地研究参考。
# 不是 V3 配置或部署指南；当前项目没有需要维护的生产实例。
# 在本机 .env 中填写私有值，不得提交真实密码。

POSTGRES_DB=stock_race_local
POSTGRES_USER=stock_race_local
POSTGRES_PASSWORD=__SET_LOCAL_ONLY__

TSDB_DB=stock_race_tsdb_local
TSDB_USER=stock_race_tsdb_local
TSDB_PASSWORD=__SET_LOCAL_ONLY__

REDIS_PASSWORD=__SET_LOCAL_ONLY__
REDIS_MAX_MEMORY=256mb

GRAFANA_USER=__SET_LOCAL_ONLY__
GRAFANA_PASSWORD=__SET_LOCAL_ONLY__
GRAFANA_URL=http://127.0.0.1:3002

# 以下为 SR-004 卫生施工后新增的必填项（源码与 compose 均已移除弱默认值，
# 缺失即显式报错）。值只写本机 .env，不得提交。

# backend：JWT 签名密钥 / 初始管理员口令 / 服务间 API 密钥
JWT_SECRET=__SET_LOCAL_ONLY__
ADMIN_PASSWORD=__SET_LOCAL_ONLY__
BACKEND_API_KEY=__SET_LOCAL_ONLY__
AI_SERVICE_API_KEY=__SET_LOCAL_ONLY__
DATA_SERVICE_API_KEY=__SET_LOCAL_ONLY__

# 数据库口令（backend/ai-service/data-service 通过 DB_PASSWORD 读取）
DB_PASSWORD=__SET_LOCAL_ONLY__

# 种子脚本创建 admin 用户时的口令（backend/prisma/seed.js、run-seeds.js）
SEED_ADMIN_PASSWORD=__SET_LOCAL_ONLY__

# 开发编排附件（docker-compose.yml / backend/docker-compose*.yml）
PGADMIN_DEFAULT_PASSWORD=__SET_LOCAL_ONLY__
HTTP_PASSWORD=__SET_LOCAL_ONLY__
GF_SECURITY_ADMIN_PASSWORD=__SET_LOCAL_ONLY__

# 前端环境变量配置示例

# API基础URL
VITE_API_BASE_URL=http://localhost:3001/api

# WebSocket URL
VITE_WS_URL=ws://localhost:3001

# 应用配置
VITE_APP_NAME=Stock Race
VITE_APP_VERSION=0.1.0

# 开发环境配置
VITE_DEBUG=true

# 生产环境配置（示例）
# VITE_API_BASE_URL=https://api.stock-race.com/api
# VITE_WS_URL=wss://api.stock-race.com
# VITE_DEBUG=false
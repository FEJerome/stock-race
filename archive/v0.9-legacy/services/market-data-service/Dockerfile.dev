# Data Service Development Dockerfile (联调/生产兼容)
# 重要：此 Dockerfile 需要在项目根目录作为 build context 运行
# 例如：docker build -f market-data-service/Dockerfile.dev -t market-data:dev .
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 先复制并安装 infra SDK
COPY infra/health-check/src /app/infra/health-check/src
RUN pip install --no-cache-dir /app/infra/health-check/src

# 复制 Market Data Service 源代码
COPY market-data-service/src ./src
COPY market-data-service/pyproject.toml .

# 安装依赖 (直接从 pyproject.toml 解析 dependencies)
RUN pip install --no-cache-dir \
    fastapi>=0.104.0 \
    uvicorn[standard]>=0.24.0 \
    pydantic>=2.5.0 \
    pandas>=2.1.0 \
    numpy>=1.24.0 \
    httpx>=0.25.0 \
    redis>=5.0.0 \
    psycopg2-binary>=2.9.0 \
    sqlalchemy>=2.0.0 \
    aiohttp>=3.9.0 \
    celery>=5.3.0 \
    python-dotenv>=1.0.0 \
    tenacity>=8.2.0 \
    loguru>=0.7.0 \
    yfinance>=0.2.0 \
    ta-lib>=0.4.0 \
    pytest>=7.4.0 \
    pytest-asyncio>=0.21.0 \
    python-jose[cryptography]>=3.3.0 \
    pydantic-settings>=2.0.0 \
    akshare>=1.15.0 \
    baostock>=0.8.8 \
    tushare>=1.3.0 \
    asyncpg>=0.30.0

# 设置 PYTHONPATH 让 Python 能找到 src 下的模块
ENV PYTHONPATH=/app/src

# 暴露端口
EXPOSE 8001

# 启动开发服务器（支持热重载）
CMD ["uvicorn", "data_service.main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]

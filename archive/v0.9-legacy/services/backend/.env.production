# Backend Production Environment Configuration
# 请在生产环境中修改所有默认值

# 应用配置
NODE_ENV=production
PORT=3001
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_race_prod
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50

# Redis配置
REDIS_URL=redis://:CHANGE_ME_IN_PRODUCTION@localhost:6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_DB=0
REDIS_MAX_MEMORY=256mb

# 会话配置
SESSION_TTL=86400
MAX_SESSIONS_PER_USER=10

# JWT配置 - 生产环境必须使用强密钥
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=24h

# 管理员密码
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# AI Service配置
AI_SERVICE_URL=http://trading-ai-service:8000
DATA_SERVICE_URL=http://market-data-service:8001
DATA_SERVICE_API_PREFIX=/api/v1
DATA_SERVICE_HEALTH_CHECK_INTERVAL=30000
DATA_SERVICE_MAX_FALLBACK_DURATION=300000
DATA_SERVICE_QUALITY_THRESHOLD=0.8

# API Keys for Service Communication
API_KEY=stock-race-api-key-production
AI_SERVICE_API_KEY=stock-race-ai-key-production
DATA_SERVICE_API_KEY=stock-race-data-key-production

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=warn

# Email Configuration (for notifications)
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASS=CHANGE_ME_IN_PRODUCTION

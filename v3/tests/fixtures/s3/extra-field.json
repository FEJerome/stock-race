{
  "schemaVersion": "1.0.0",
  "name": "S3 fake 样例：额外字段",
  "indicators": {
    "m": {
      "use": "macd@1",
      "surprise": true
    }
  },
  "entry": {
    "gt": [
      {
        "ref": "m.dif"
      },
      {
        "const": "0"
      }
    ]
  },
  "exits": [
    {
      "lt": [
        {
          "ref": "m.dif"
        },
        {
          "const": "0"
        }
      ]

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://stock-race.local/schema/run-event.schema.json",
  "title":"RunEvent","type":"object","additionalProperties":false,
  "required":["eventVersion","runDigest","seq","tradingDate","phase","type","reasonCodes","inputRefs","payload","previousEventHash","eventHash"],
  "properties":{
    "eventVersion":{"const":"1.0.0"},
    "runDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "seq":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "tradingDate":{"type":"string"},
    "phase":{"enum":["session-open","open-execution","close","run-end"]},
    "type":{"enum":["SessionOpened","CorporateActionApplied","SignalEvaluated","OrderIntentCreated","OrderRejected","OrderFilled","PositionChanged","CashChanged","MarkToMarket","MetricComputed","RunCompleted","RunFailed"]},
    "reasonCodes":{"type":"array","items":{"type":"string"}},
    "inputRefs":{"type":"object","additionalProperties":{"type":["string","number","boolean","null"]}},
    "payload":true,
    "previousEventHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "eventHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}

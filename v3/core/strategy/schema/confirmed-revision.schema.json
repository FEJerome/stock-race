{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-race.local/schema/confirmed-revision.schema.json",
  "title": "ConfirmedRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategyId", "revision", "digest", "createdAt"],
  "properties": {
    "strategyId": {"type": "string", "pattern": "^strategy-[0-9]{6}$"},
    "revision": {"$ref": "common.schema.json#/$defs/positiveSafeInteger"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "createdAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"}
  }
}

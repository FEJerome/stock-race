{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://stock-race.local/schema/data-snapshot.schema.json",
  "title":"DataSnapshot","type":"object","additionalProperties":false,
  "required":["snapshotVersion","digest","assetIdentity","observationKind","sessions","corporateActions","source","fixedRange","adjustment","pricePrecision","volumeUnit","qualityIssues","usageRestriction"],
  "properties":{
    "snapshotVersion":{"const":"1.0.0"},
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "assetIdentity":{"type":"object","additionalProperties":false,"required":["assetId","type","sourceTypeRaw","status"],"properties":{"assetId":{"type":"string"},"type":{"const":"stock"},"sourceTypeRaw":{"type":"string"},"status":{"type":"string"}}},
    "observationKind":{"const":"ohlcv"},
    "sessions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/session"}},
    "corporateActions":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/cashDividend"},{"$ref":"#/$defs/bonusIssue"}]}},
    "source":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","interface","libraryVersion"],"properties":{"name":{"type":"string"},"interface":{"type":"string"},"libraryVersion":{"type":"string"}}}},
    "fixedRange":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"string"},"end":{"type":"string"}}},
    "adjustment":{"enum":["raw","qfq","hfq","unknown"]},
    "pricePrecision":{"type":"integer","minimum":0,"maximum":12},
    "volumeUnit":{"const":"share"},
    "qualityIssues":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","blocking","message"],"properties":{"code":{"type":"string"},"blocking":{"type":"boolean"},"message":{"type":"string"}}}},
    "usageRestriction":{"type":"string"}
  },
  "$defs":{
    "bar":{"type":"object","additionalProperties":false,"required":["date","open","high","low","close","volume"],"properties":{"date":{"type":"string"},"open":{"$ref":"common.schema.json#/$defs/decimalString"},"high":{"$ref":"common.schema.json#/$defs/decimalString"},"low":{"$ref":"common.schema.json#/$defs/decimalString"},"close":{"$ref":"common.schema.json#/$defs/decimalString"},"volume":{"$ref":"common.schema.json#/$defs/decimalString"},"signalOpen":{"$ref":"common.schema.json#/$defs/decimalString"},"signalHigh":{"$ref":"common.schema.json#/$defs/decimalString"},"signalLow":{"$ref":"common.schema.json#/$defs/decimalString"},"signalClose":{"$ref":"common.schema.json#/$defs/decimalString"}}},
    "session":{"type":"object","additionalProperties":false,"required":["date","status"],"properties":{"date":{"type":"string"},"status":{"enum":["trading","suspended","missing"]},"bar":{"$ref":"#/$defs/bar"}}},
    "cashDividend":{"type":"object","additionalProperties":false,"required":["type","recordDate","exDate","payDate","cashPerShare"],"properties":{"type":{"const":"cashDividend"},"recordDate":{"type":"string"},"exDate":{"type":"string"},"payDate":{"type":"string"},"cashPerShare":{"$ref":"common.schema.json#/$defs/decimalString"}}},
    "bonusIssue":{"type":"object","additionalProperties":false,"required":["type","recordDate","exDate","listingDate","ratioNumerator","ratioDenominator"],"properties":{"type":{"const":"bonusIssue"},"recordDate":{"type":"string"},"exDate":{"type":"string"},"listingDate":{"type":"string"},"ratioNumerator":{"$ref":"common.schema.json#/$defs/positiveSafeInteger"},"ratioDenominator":{"$ref":"common.schema.json#/$defs/positiveSafeInteger"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-race.local/schema/readback.schema.json",
  "title": "Readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["readbackVersion", "locale", "registryVersion", "canonicalizationVersion", "strategyDigest", "summary", "clauses", "text"],
  "properties": {
    "readbackVersion": {"const": "1.0.0"},
    "locale": {"const": "zh-CN"},
    "registryVersion": {"const": "1.0.0"},
    "canonicalizationVersion": {"const": "canonicalization@1"},
    "strategyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1},
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["astPath", "text"],
        "properties": {
          "astPath": {"$ref": "common.schema.json#/$defs/jsonPointer"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "text": {"type": "string", "minLength": 1}
  }
}

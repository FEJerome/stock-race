# Data Service Production Environment Configuration
# 请在生产环境中修改所有默认值

# Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=False

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# TimescaleDB Configuration
TSDB_HOST=timescaledb
TSDB_PORT=5432
TSDB_NAME=stock_race_tsdb_prod
TSDB_USER=tsdb_user
TSDB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_race_prod
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Redis Configuration
REDIS_URL=redis://:CHANGE_ME_IN_PRODUCTION@redis:6379

# Data Source API Keys
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
TIINGO_API_KEY=your-tiingo-api-key
YAHOO_FINANCE_ENABLED=True

# Chinese Stock Data APIs
TUSHARE_TOKEN=your-tushare-token-here
AKSHARE_ENABLED=True
BAOSTOCK_ENABLED=True

# Data Collection Configuration
COLLECTION_INTERVAL=60
BATCH_SIZE=100
MAX_RETRIES=3

# Market Hours (China A-share market)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=0

# Data Retention
RAW_DATA_RETENTION_DAYS=365
AGGREGATED_DATA_RETENTION_DAYS=730

# Rate Limiting
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_PERIOD=60

# Service URLs
BACKEND_URL=http://backend:3001
AI_SERVICE_URL=http://ai-service:8000

# API Keys for Service Communication
API_KEY=stock-race-data-key-production
BACKEND_API_KEY=stock-race-api-key-production

# Logging
LOG_LEVEL=WARNING
LOG_FILE=logs/data_service.log

# Default Stock Symbols (Chinese A-share stocks)
DEFAULT_STOCK_SYMBOLS=000001.SZ,000002.SZ,000858.SZ,600036.SH,600519.SH

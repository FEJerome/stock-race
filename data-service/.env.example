# 旧 data-service 本地配置模板；不是 V3 数据导入器配置。
# 外部数据源默认关闭，调用前需要单独授权。

HOST=127.0.0.1
PORT=8001
DEBUG=False

CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001

# 旧 TimescaleDB 配置
TSDB_HOST=127.0.0.1
TSDB_PORT=5433
TSDB_NAME=stock_race_tsdb
TSDB_USER=stock_race_tsdb_local
TSDB_PASSWORD=__SET_LOCAL_ONLY__

# 旧 PostgreSQL 与 Redis 配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stock_race
DB_USER=stock_race_local
DB_PASSWORD=__SET_LOCAL_ONLY__
REDIS_URL=redis://127.0.0.1:6379

# 外部数据源密钥只填写在本机 .env，不得提交
ALPHA_VANTAGE_API_KEY=
TIINGO_API_KEY=
TUSHARE_TOKEN=
YAHOO_FINANCE_ENABLED=False
AKSHARE_ENABLED=False
BAOSTOCK_ENABLED=False

COLLECTION_INTERVAL=60
BATCH_SIZE=100
MAX_RETRIES=3

MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=0

RAW_DATA_RETENTION_DAYS=365
AGGREGATED_DATA_RETENTION_DAYS=730

RATE_LIMIT_REQUESTS=50
RATE_LIMIT_PERIOD=60

BACKEND_URL=http://127.0.0.1:3001
AI_SERVICE_URL=http://127.0.0.1:8000

LOG_LEVEL=INFO
LOG_FILE=logs/data_service.log

DEFAULT_STOCK_SYMBOLS=000001.SZ,000002.SZ,000858.SZ,600036.SH,600519.SH

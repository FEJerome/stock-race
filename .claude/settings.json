{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Bash(node:*)",
      "Bash(npm create vite@latest:*)",
      "Bash(npm init:*)",
      "Bash(ls:*)",
      "Bash(npm install:*)",
      "Bash(curl:*)",
      "Bash(npm start)",
      "Bash(npm run dev:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(taskkill:*)",
      "Bash(tasklist:*)",
      "Bash(powershell -Command:*)",
      "Bash(tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(wc:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git branch:*)",
      "Bash(dir:*)",
      "Bash(timeout:*)",
      "Bash(git worktree move:*)",
      "Bash(start node:*)",
      "Bash(python -c:*)",
      "Bash(start /B npm start:*)",
      "Bash(python:*)",
      "Bash(npm run build:*)",
      "Bash(npm restart:*)",
      "Bash(powershell:*)",
      "Bash(ping:*)",
      "Bash(wmic process where:get CommandLine)",
      "Bash(wmic process where:get CreationDate)",
      "Bash(printenv:*)",
      "Bash(git push:*)",
      "Bash(git worktree remove:*)",
      "Bash(systemctl:*)",
      "Bash(xargs:*)",
      "Bash(set CLAUDE_SESSION_JSON=true)",
      "Bash(export:*)",
      "Bash(unset:*)",
      "Bash(git pull:*)",
      "Bash(CLAUDE_MODEL_TYPE=deepseek node:*)",
      "Bash(CLAUDE_MODEL_TYPE=glm node:*)",
      "Bash(CLAUDE_MODEL_TYPE=kimi node:*)",
      "Bash(CLAUDE_MODEL_TYPE=deepseek CLAUDE_OPTIMIZATION_PROFILE=aggressive node:*)",
      "Bash(CLAUDE_MODEL_TYPE=kimi CLAUDE_OPTIMIZATION_PROFILE=relaxed node:*)",
      "Bash(CLAUDE_MODEL_CONTEXT_SIZE=200 node:*)",
      "Bash(CLAUDE_MODEL_TYPE=deepseek CLAUDE_CLEANUP_MAX_SESSIONS=8 CLAUDE_COMPACT_THRESHOLD=45 node:*)"
    ]
  }
}
